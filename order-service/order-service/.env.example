# Optionnel : remplace les paramètres MYSQL_* si une URL complète est préférée.
# Exemple : mysql+pymysql://order_user:mot_de_passe@localhost:3306/order_service_db?charset=utf8mb4
# DATABASE_URL=

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=orders_db
MYSQL_USER=MYSQL84_1
MYSQL_PASSWORD=change_me

EUREKA_ENABLED=true
EUREKA_SERVER=http://localhost:8761/eureka/
EUREKA_APP_NAME=order-service
EUREKA_INSTANCE_HOST=127.0.0.1
EUREKA_INSTANCE_PORT=8085

# RabbitMQ : la connexion est créée uniquement par le code de messagerie.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_EXCHANGE=payment.events
RABBITMQ_QUEUE=order-service.payment-succeeded
RABBITMQ_ROUTING_KEY=payment.succeeded
