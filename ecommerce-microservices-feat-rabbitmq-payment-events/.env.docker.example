# Copy this file to .env.docker and replace every CHANGE_ME value.
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password
MYSQL_DATABASE=orders_db
MYSQL_USER=order_user
MYSQL_PASSWORD=CHANGE_ME_mysql_order_password

MONGODB_DATABASE=payment_db

RABBITMQ_DEFAULT_USER=ecommerce_app
RABBITMQ_DEFAULT_PASS=CHANGE_ME_rabbitmq_password
RABBITMQ_DEFAULT_VHOST=/

# Use the version of the existing local Keycloak installation when possible.
KEYCLOAK_ADMIN_USERNAME=abdelmajid
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin_password
KEYCLOAK_PUBLIC_URL=http://localhost:8180
KEYCLOAK_REALM=EcommerceRealm
