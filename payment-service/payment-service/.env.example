# URI locale de MongoDB. Ne pas ajouter de vrai mot de passe dans ce fichier.
MONGODB_URI=mongodb://localhost:27017/payment_db

# Mode local de démonstration : commandes fictives et montant de référence
ORDER_CLIENT_MODE=local
ORDER_SERVICE_BASE_URL=http://localhost:8085
ORDER_SERVICE_CONNECT_TIMEOUT=2s
ORDER_SERVICE_READ_TIMEOUT=3s
LOCAL_ORDER_IDS=1001,1002
LOCAL_ORDER_AMOUNT=49.99
LOCAL_ORDER_CURRENCY=TND

# Le paiement simulé de cette commande est refusé
SIMULATED_DECLINED_ORDER_IDS=1002

# RabbitMQ local credentials: replace these placeholders with a local user.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=payment_service
RABBITMQ_PASSWORD=change_me
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_PAYMENT_EXCHANGE=payment.exchange
RABBITMQ_PAYMENT_ROUTING_KEY=payment.succeeded

# Mode local de démonstration : les commandes sont fictives et listées ci-dessous
ORDER_CLIENT_MODE=local
LOCAL_ORDER_IDS=1001,1002
LOCAL_ORDER_AMOUNT=49.99
LOCAL_ORDER_CURRENCY=TND

# Le paiement de cette commande de démonstration est refusé par le simulateur
SIMULATED_DECLINED_ORDER_IDS=1002
